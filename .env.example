# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 Git에 올리지 마세요)

# Google 로그인 — Google Cloud 콘솔의 "웹 애플리케이션" OAuth 클라이언트 ID (클라이언트 보안 비밀번호는 필요 없음)
GOOGLE_CLIENT_ID=

# Gemini AI 분석 — https://aistudio.google.com/apikey 에서 발급한 API 키
GEMINI_API_KEY=

# 선택: 사용할 모델 (기본값: gemini-3.6-flash)
# HEALTHLINGO_AI_MODEL=gemini-3.6-flash
# 선택: 기본 모델이 과부하·지연일 때 순서대로 대신 쓸 모델 (쉼표 구분, 끄려면 none)
# HEALTHLINGO_AI_FALLBACK_MODELS=gemini-3.5-flash-lite
# 선택: 모델 1개당 최대 대기 시간(초, 기본 45)
# HEALTHLINGO_AI_TIMEOUT=45

# 선택: Claude로 되돌리려면 아래 두 줄을 쓰세요
# HEALTHLINGO_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# 선택: 서버 주소·포트·데이터 폴더
# HEALTHLINGO_HOST=127.0.0.1
# HEALTHLINGO_PORT=8000
# HEALTHLINGO_DATA_DIR=data

# 외부 공개 접근 제어 (README의 '외부 공개' 참고)
# 공개 주소 — 예: Tailscale Funnel 주소 https://내PC이름.xxxx.ts.net
# HEALTHLINGO_PUBLIC_URL=
# 초대 링크 코드 — 새 코드 만들기: .venv\Scripts\python.exe run.py --new-invite-code
# HEALTHLINGO_INVITE_CODE=
# 로그인을 허용할 Google 계정 (쉼표로 구분)
# HEALTHLINGO_ALLOWED_EMAILS=me@gmail.com,friend@gmail.com

# 선택: HTTPS로 배포할 때만 1 (쿠키에 Secure 표시, 공개 주소가 https면 자동)
# HEALTHLINGO_COOKIE_SECURE=1

# 선택: 이 컴퓨터에서만 쓰는 개발용 테스트 로그인 (Google 계정 아님). 실제 사용 시에는 끄세요.
# HEALTHLINGO_DEV_LOGIN=1
